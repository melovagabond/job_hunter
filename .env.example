# job_hunter environment configuration
# Copy this file to .env and fill in the values:  cp .env.example .env
# The worker and API both read this file at startup via dotenv.
# Sanity check: dotenv prints "injected env (N)" at boot. If N is 0,
# your .env is empty and the keyed sources will skip themselves.

# ---------------------------------------------------------------------------
# Adzuna (primary source: does salary floor AND 50-mile geo filtering
# server side, so it feeds the matcher the cleanest input)
#
# 1. Register at https://developer.adzuna.com (free)
# 2. Create an application; you get an App ID and an App Key
# 3. Free tier is fine for this project's 3 fetches/day schedule
# ---------------------------------------------------------------------------
ADZUNA_APP_ID=your_app_id_here
ADZUNA_APP_KEY=your_app_key_here

# ---------------------------------------------------------------------------
# USAJobs (federal roles, real posted salaries, radius param in miles)
#
# 1. Request a key at https://developer.usajobs.gov (free, arrives by email)
# 2. USAJOBS_EMAIL must be the EXACT email you registered with; it is
#    sent as the User-Agent header and they validate the pair.
#    Wrong email = 401 even with a valid key.
# ---------------------------------------------------------------------------
USAJOBS_API_KEY=your_key_here
USAJOBS_EMAIL=you@example.com

# ---------------------------------------------------------------------------
# Optional overrides (defaults shown, uncomment to change)
# ---------------------------------------------------------------------------

# Where the SQLite ledger lives. Back this file up; it is your entire
# application history. In docker compose this is set to /app/data.
#JOB_DB_PATH=./data/jobs.sqlite

# Fetch schedule, standard cron syntax, America/New_York timezone.
# Default is 7am, 1pm, 7pm. Do not set this to every minute; job boards
# do not change that fast and rate limits are real.
#FETCH_CRON=0 7,13,19 * * *

# Port for the API + dashboard.
#API_PORT=3001

# ---------------------------------------------------------------------------
# NOT environment variables, but the other half of configuration:
#
#   config/criteria.json  titles allowlist/exclusions, salary floor,
#                         geo rule, weekly apply cap
#   config/sources.json   which sources run; Greenhouse boards[] and
#                         Lever companies[] are your target-company
#                         lists and start EMPTY
# ---------------------------------------------------------------------------
